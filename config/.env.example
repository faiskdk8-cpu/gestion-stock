APP_NAME="Gestion Stock Boutique"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://gestion-stock.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_stock
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sanctum — domaines autorisés pour les cookies SPA
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:5173,gestion-stock.test

# CORS — origine du frontend React (Vite tourne sur 5173)
FRONTEND_URL=http://localhost:5173
